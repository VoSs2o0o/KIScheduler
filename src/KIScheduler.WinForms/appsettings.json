{
  "Runtime": {
    "DataDirectory": ""
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Directory": "logs",
      "FileNamePrefix": "kischeduler-",
      "RetainedFileCountLimit": 14
    }
  },
  "Worker": {
    "Enabled": true
  },
  "Scheduler": {
    "PollInterval": "00:00:10",
    "LeaseDuration": "1.00:00:00",
    "ExecutionTimeout": "02:00:00",
    "HistoryUsageEventInterval": "00:10:00",
    "AgingInterval": "00:30:00",
    "AgingBonusPerInterval": 1,
    "MaximumAttempts": 3,
    "RetryBackoff": "00:01:00",
    "MaximumRetryBackoff": "00:30:00"
  },
  "Persistence": {
    "DatabasePath": "data/kischeduler.db"
  },
  "Codex": {
    "Executable": "codex",
    "Sandbox": "workspace-write",
    "AvailabilityTimeout": "00:00:10",
    "AppServerRequestTimeout": "00:00:15",
    "UsageCacheDuration": "00:00:30",
    "AppServerArguments": [ "app-server", "--listen", "stdio://" ]
  },
  "Claude": {
    "Executable": "claude",
    "PermissionMode": "acceptEdits",
    "AvailabilityTimeout": "00:00:10",
    "AdditionalArguments": [],
    "Usage": {
      "Executable": "claude",
      "Arguments": [ "-p", "/usage" ],
      "Pattern": "Current session:\\s*(?<used>\\d+(?:\\.\\d+)?)%\\s*used(?:\\s*[·•]\\s*resets\\s+(?<reset>[A-Za-z]{3}\\s+\\d{1,2},\\s*\\d{1,2}:\\d{2}(?:am|pm)\\s*\\([^)]+\\)))?",
      "WeeklyPattern": "Current week\\s*\\(all models\\):\\s*(?<used>\\d+(?:\\.\\d+)?)%\\s*used(?:\\s*[·•]\\s*resets\\s+(?<reset>[A-Za-z]{3}\\s+\\d{1,2},\\s*\\d{1,2}:\\d{2}(?:am|pm)\\s*\\([^)]+\\)))?",
      "CostPattern": "Total cost:\\s*(?<cost>\\$\\s*\\d+(?:\\.\\d+)?)",
      "FreeAccountPattern": "\\bfree\\s+(?:account|plan|tier)\\b",
      "UsedGroupName": "used",
      "ResetGroupName": "reset",
      "Culture": "en-US",
      "Unit": "Percent",
      "RegexTimeout": "00:00:00.250",
      "CommandTimeout": "00:00:15",
      "WindowName": "Current session",
      "Source": "claude-command-regex"
    }
  }
}
