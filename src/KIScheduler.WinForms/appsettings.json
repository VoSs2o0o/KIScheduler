{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "File": {
      "Directory": "logs",
      "FileNamePrefix": "kischeduler-",
      "RetainedFileCountLimit": 14
    }
  },
  "Worker": {
    "Enabled": true
  },
  "Persistence": {
    "DatabasePath": "data/kischeduler.db"
  }
}
